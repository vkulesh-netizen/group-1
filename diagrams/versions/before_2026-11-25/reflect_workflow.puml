@startuml
title Reflective Worker Workflow

start
:Receive draft and retrieved evidence;

if (Is the draft empty?) then (yes)
    :Set verdict to insufficient evidence;
    :Withhold an answer;
else (no)
    :Compare each draft line and citation ID
    with its evidence record;

    if (Does every line match its evidence?) then (yes)
        :Set verdict to evidence matched;
        :Return cited answer;
    else (no)
        :Set verdict to unsupported draft;
        :Withhold the draft;
    endif
endif

:Return verdict and result to LangGraph;
stop

@enduml