

@startuml title
title HealthResearch AI - Overall Architecture

top to bottom direction
skinparam componentStyle rectangle

actor "Health Research User" as User

package "Presentation Layer" {
    component "Streamlit Frontend" as UI
}

package "Agent Orchestration Layer" {
    component "LangGraph Orchestrator" as Graph
    component "Planner / Router Agent" as Planner
}

package "Worker Agents - Level 2" {
    component "Research Agent" as Research
    component "Summarization Agent" as Summary
    component "Reflection Agent" as Reflection
}

package "Knowledge and Retrieval Layer" {
    component "LangChain RAG Tool" as RAG
    database "ChromaDB Health Knowledge Base" as DB
}

cloud "Shared LLM Provider" as LLM

User --> UI : Health inquiry
UI --> Graph : Question
Graph --> Planner : Classify and route
Planner --> Graph : Routing decision

Graph --> Research : Research request
Research --> RAG : Retrieve evidence
RAG --> DB : Similarity search
DB --> RAG : Relevant documents
RAG --> Research : Evidence and citations

Research --> Graph : Retrieved evidence
Graph --> Summary : Generate summary
Summary --> Graph : Draft answer

Graph --> Reflection : Review draft
Reflection --> Graph : Review result

Graph --> UI : Final cited answer

Planner ..> LLM
Research ..> LLM
Summary ..> LLM
Reflection ..> LLM

@enduml
